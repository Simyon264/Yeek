<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Database\Migrations\Script0001_Init.sql" />
        <EmbeddedResource Include="Database\Migrations\Script0002_FileSizes.sql" />
        <EmbeddedResource Include="Database\Migrations\Script0003_RevisionDescription.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0004_Moderation.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0005_UserLastLogin.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0006_UserNotesTime.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0007_FilePreviews.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0008_LockedFiles.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0009_FilePreviewRegenerations.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0010_Downloads.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0011_MultiAuthor.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0012_ContentRemoval.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0013_MassEdit.sql"/>
        <EmbeddedResource Include="Database\Migrations\Script0014_Playlists.sql"/>
    </ItemGroup>

    <Target Name="NpmInstall" Inputs="JavaScript/package.json" Outputs="JavaScript/node_modules/.install-stamp">
        <Exec Command="npm install" WorkingDirectory="JavaScript" />
        <Touch Files="JavaScript/node_modules/.install-stamp" AlwaysCreate="true" />
    </Target>

    <Target Name="NpmRunBuild" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild" Inputs="@(NpmSourceFiles)" Outputs="JavaScript/.build-stamp">
        <Exec Command="npm run build" WorkingDirectory="JavaScript" />
        <Touch Files="JavaScript/.build-stamp" AlwaysCreate="true" />
    </Target>

    <ItemGroup>
        <NpmSourceFiles Include="JavaScript/src/**/*.*" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Dapper" Version="2.1.66" />
      <PackageReference Include="FFMpegCore" Version="5.2.0" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.8" />
      <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.0" />
      <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="7.5.0" />
      <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.0" />
      <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.8" />
      <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
      <PackageReference Include="Npgsql" Version="9.0.3" />
      <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
      <PackageReference Include="SpaceWizards.NFluidsynth" Version="0.2.2" />
      <PackageReference Include="System.Linq.Async" Version="7.0.0" />
      <PackageReference Include="TickerQ" Version="2.5.3" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="data\uploads\" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Components\Pages\About\About.razor" />
      <_ContentIncludedByDefault Remove="Components\Pages\About\FAQ.razor" />
      <_ContentIncludedByDefault Remove="Components\Pages\About\Privacy.razor" />
    </ItemGroup>

</Project>
